	],
	"play": [
		"...........", "..#........", "..##.......", "..###......", "..####.....", "..#####....",
		"..####.....", "..###......", "..##.......", "..#........", "...........",
	],
	"step": [
		"...........", ".#.....##..", ".##....##..", ".###...##..", ".####..##..", ".#####.##..",
		".####..##..", ".###...##..", ".##....##..", ".#.....##..", "...........",
	],
	"undo": [
		"...........", "...#.......", "..##.......", ".#######...", "..##....#..", "...#.....#.",
		".........#.", ".........#.", "........#..", "....####...", "...........",
	],
	"trash": [
		"....###....", ".#########.", "...........", "..#######..", "..#.#.#.#..", "..#.#.#.#..",
		"..#.#.#.#..", "..#.#.#.#..", "..#.#.#.#..", "..#######..", "...........",
	],
	"save": [
		"#########..", "#.#####.##.", "#.#####.#.#", "#.......#.#", "#.........#", "#.#######.#",
		"#.#.....#.#", "#.#.....#.#", "#.#.....#.#", "###########", "...........",
	],
	"gear": [
		".....#.....", "..#.###.#..", "...#####...", "..##...##..", ".###...###.", "..##...##..",
		"...#####...", "..#.###.#..", ".....#.....", "...........", "...........",
	],
	"brush": [
		".........##", "........###", ".......###.", "......###..", ".....###...", "....##.....",
		"...###.....", "..####.....", ".#####.....", ".####......", ".##........",
	],
	"eraser": [
		"...........", "......###..", ".....#####.", "....#######", "...#.#####.", "..#...###..",
		".#.....#...", ".#....#....", "..#..#.....", "...##......", "...........",
	],
	"heat": [
		".....#.....", ".....##....", "....###....", "....####...", "...#####.#.", "..###.####.",
		"..##...###.", ".###...###.", "..##...##..", "...#####...", "...........",
	],
	"cool": [
		".....#.....", "...#.#.#...", "....###....", ".#..###..#.", "..#..#..#..", ".#########.",
		"..#..#..#..", ".#..###..#.", "....###....", "...#.#.#...", ".....#.....",
	],
	"neutron": [
		"#.........#", ".#...#...#.", "...........", "....###....", "...#####...", ".#.#####.#.",

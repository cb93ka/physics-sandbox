	],
	"replace": [
		"#######....", "#.....#....", "#.....#....", "#...#######", "#...#.....#", "#...#.....#",
		"#######...#", "....#.....#", "....#.....#", "....#######", "...........",
	],
	"up": [
		"...........", "...........", "...........", ".....#.....", "....###....", "...##.##...",
		"..##...##..", ".##.....##.", "...........", "...........", "...........",
	],

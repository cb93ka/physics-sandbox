	],
	"target": [
		".....#.....", ".....#.....", "...........", "...........", "...........", "##.......##",
		"...........", "...........", "...........", ".....#.....", ".....#.....",
	],
}

static var _cache: Dictionary = {}


static func get_icon(icon_name: String) -> Texture2D:
	if _cache.has(icon_name):
		return _cache[icon_name]
	var rows: Array = PATTERNS.get(icon_name, [])
	if rows.is_empty():
		return null
	var h := rows.size()
	var w := 0
	for r: Variant in rows:
		w = maxi(w, str(r).length())
	var img := Image.create_empty(w, h, false, Image.FORMAT_RGBA8)
	img.fill(Color(0, 0, 0, 0))
	for y in h:
		var row := str(rows[y])
		for x in row.length():
			if row[x] == "#":
				img.set_pixel(x, y, Color.WHITE)
	img.resize(w * SCALE, h * SCALE, Image.INTERPOLATE_NEAREST)
	var tex := ImageTexture.create_from_image(img)
	_cache[icon_name] = tex
	return tex


## Квадратная цветная плашка для материала (с тёмной рамкой и бликом).
static func swatch(col: Color, px: int = 16) -> Texture2D:
	var key := "sw_%s_%d" % [col.to_html(false), px]
	if _cache.has(key):
		return _cache[key]
	var img := Image.create_empty(px, px, false, Image.FORMAT_RGBA8)
	img.fill(Color(0.02, 0.02, 0.03))
	img.fill_rect(Rect2i(2, 2, px - 4, px - 4), col)
	img.fill_rect(Rect2i(2, 2, px - 4, 2), col.lightened(0.25))
	img.fill_rect(Rect2i(2, px - 4, px - 4, 2), col.darkened(0.25))
	var tex := ImageTexture.create_from_image(img)
	_cache[key] = tex
	return tex
